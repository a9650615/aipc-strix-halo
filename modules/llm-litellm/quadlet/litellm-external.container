[Unit]
Description=LiteLLM proxy gateway for AIPC (LAN-facing, ESP32 LLM host)
# Separate process from litellm.service on purpose — see config-external.yaml
# for why (scheduler double-admission risk) and README "External LAN gateway
# (ESP32 host)" for the auth/network split. Requires resident-small already
# reachable via the internal Lemonade backend.
After=network-online.target lemonade.service
Wants=network-online.target
Requires=lemonade.service

[Container]
Image=ghcr.io/berriai/litellm@sha256:afdc3cc37493d4f86d485ad7ac4445e7154c568a8d47c01bad15c9cf062c66b5
ContainerName=litellm-external
Network=host
Volume=/etc/aipc/litellm/config-external.yaml:/app/config.yaml:ro,Z
Exec=--config /app/config.yaml --host 0.0.0.0 --port 4001
# Master key lives in its own file, NOT cloud-keys.env (that file is also
# read by litellm.service, the keyless internal :4000 instance — sharing it
# would put every existing internal consumer, none of which send an
# Authorization header, behind auth and break them). Not in git.
EnvironmentFile=/etc/aipc/env.d/llm-litellm/external-key.env

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
