[Unit]
Description=Lemonade SDK NPU/ROCm inference server
After=network-online.target systemd-machined.service
Requires=network-online.target
ConditionPathExists=/dev/accel/accel0

[Service]
Type=simple
Restart=always
RestartSec=5
# FLM's NPU driver validation fails ("Memlock limits are too low") under
# systemd's restrictive default LimitMEMLOCK for system units — hardware-
# verified 2026-07-04: the identical `podman run` invocation succeeds when
# launched from an interactive shell (higher inherited ulimit) and fails
# under this real service unit without this. --ulimit on the podman
# command itself is the one that actually matters (podman gives the
# container its own default ulimits regardless of the launching process's
# limits); LimitMEMLOCK= here covers the podman process itself.
LimitMEMLOCK=infinity
TimeoutStopSec=30
ExecStartPre=-/usr/bin/podman rm -f lemonade
ExecStartPre=/usr/bin/mkdir -p /var/lib/aipc-lemonade/cache /var/lib/aipc-lemonade/flm /var/lib/aipc-models/hf
# HF model cache lives under the shared /var/lib/aipc-models tree (symlink to
# the primary user's ~/aipc-models, resolved by aipc-models-dir.service) so all
# model weights — Ollama blobs and Lemonade HF downloads — share one root.
# See configure-lemonade.sh for what this does and why.
ExecStartPre=/usr/lib/aipc/llm-lemonade/configure-lemonade.sh
# --user 0:0: v11.0.0 switched the image's default USER to non-root uid
# 10001 (gid 999) and moved its HOME/cache root to /opt/lemonade — hardware-
# checked 2026-08-17 against the pulled v11.6.0 image (`podman exec ... id`).
# The three bind-mounts below are host paths owned by root (cache/flm) and
# by the primary user uid 1000 (hf/, a tree /var/lib/aipc-models shares with
# Ollama, managed by aipc-models-dir.service) — chowning either to 10001:999
# risks breaking that other consumer. Overriding back to root here is the
# smaller, reversible change and matches every other service on this box
# (nothing else runs rootless). Revisit only if upstream removes the ability
# to run as root.
ExecStart=/usr/bin/podman run \
    --name lemonade \
    --rm \
    --user 0:0 \
    --device=/dev/accel/accel0:/dev/accel/accel0 \
    --device=/dev/kfd:/dev/kfd \
    --device=/dev/dri:/dev/dri \
    --group-add=keep-groups \
    --ulimit memlock=-1:-1 \
    -e HSA_OVERRIDE_GFX_VERSION=11.5.1 \
    -p 127.0.0.1:8001:8001 \
    -v /var/lib/aipc-lemonade/cache:/opt/lemonade/.cache/lemonade:Z \
    -v /var/lib/aipc-lemonade/flm:/opt/lemonade/.config/flm:Z \
    -v /var/lib/aipc-models/hf:/opt/lemonade/.cache/huggingface:Z \
    ghcr.io/lemonade-sdk/lemonade-server@sha256:87ee7ccb3fc059787a63038927e1d488107ff74a3cc5aa71ae77daab234661ad \
    ./lemond --host 0.0.0.0 --port 8001
ExecStop=/usr/bin/podman stop -t 20 lemonade
ExecStopPost=-/usr/bin/podman rm -f lemonade

[Install]
WantedBy=multi-user.target
